PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Required for the console's protected configuration endpoints. Keep private.
CONSOLE_ADMIN_TOKEN=replace_with_a_long_random_admin_token
# Matches the supplied local MySQL connection settings; put the real password only in .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DNS
DB_USER=harsh
DB_PASSWORD=
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=replace_with_64_hex_characters
TWO_FACTOR_BASE_URL=https://2factor.in
