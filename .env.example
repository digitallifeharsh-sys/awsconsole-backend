PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional overrides; defaults match dns_harsh local setup
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DNS
DB_USER=harsh
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD

# Optional: use a 64-character hexadecimal key for encrypted provider credentials.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY

TWO_FACTOR_BASE_URL=https://2factor.in
